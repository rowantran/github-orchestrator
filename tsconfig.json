{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "orchestrator/**/*.ts",
    "tests/*.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

{
  "name": "github-orchestrator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "GitHub task orchestration with persistent Pi sessions, human approval gates, and a local dashboard.",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "gho": "bin/gho.mjs"
  },
  "files": [
    "bin/",
    "dist/orchestrator/",
    "agent-context/",
    "extensions/orchestration.mjs",
    "dashboard/app.js",
    "dashboard/index.html",
    "dashboard/style.css",
    "obsidian-plugin/manifest.json",
    "obsidian-plugin/main.js",
    "docs/architecture.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:browser": "npm run build && playwright test --config tests/orchestration-browser/playwright.config.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "smol-toml": "^1.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "pi": {
    "skills": [
      "./agent-context/github-orchestrator"
    ],
    "extensions": []
  }
}
